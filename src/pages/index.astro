---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/blocks/intro.astro";
import Projects from "../components/blocks/projects.astro";
import Jobs from "../components/blocks/jobs.astro";
import Reviews from "../components/blocks/reviews.astro";

const telegramLink = {
  href: "https://t.me/gazov",
  label: "Написать в Telegram",
};
const hhLink = {
  href: "https://hh.ru/resume/a039d8a9ff0449d5040039ed1f4d7241315250",
  label: "Открыть резюме hh.ru",
};
const behanceLink = {
  href: "https://www.behance.net/gazoff",
  label: "Открыть Behance",
};

const topMessages = [
  "Привет, меня зовут Рустам. Я занимаюсь дизайном сайтов, интернет-магазинов и мобильных приложений.",
  "Больше 11 лет проектирую интерфейсы для крупных продуктов. Сейчас руковожу продуктовым дизайном в Urent, это фиолетовые самокаты.",
  "Сейчас открыт к новым проектам. Если у вас есть интересная дизайн-задача, напишите мне.",
];
const topLinks = [telegramLink];
const bottomMessages = [
  "Я ищу проект, где нужно глубоко продумывать логику и создавать интересные решения.",
  "Изучаю рынок и конкурентов. Это помогает понять, куда всё движется, и сделать дизайн, который опережает время.",
  "Мне нравится добавлять в интерфейсы живые детали и настраивать эмоциональную связь. Это делает продукт понятным и настоящим, вызывая у пользователя именно тот отклик, который нужен проекту.",
  "Знаю, как за счет правильной логики упростить разработку и сократить расходы, не жертвуя при этом пользовательским опытом.",
  "В общем, если у вас есть нестандартная задача, требующая вдумчивого подхода и свежих решений — это ко мне.",
];
const bottomLinks = [telegramLink, hhLink, behanceLink];
---

<Layout>
  <Intro messages={topMessages} links={topLinks} />
  <Projects />
  <Jobs />
  <Reviews />
  <Intro messages={bottomMessages} links={bottomLinks} />
</Layout>
