---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/blocks/intro.astro";
import Projects from "../components/blocks/projects.astro";
import Jobs from "../components/blocks/jobs.astro";
import Reviews from "../components/blocks/reviews.astro";
import { links } from "../data.ts";

const topMessages = [
  {
    text: "Привет, меня зовут Рустам. Я занимаюсь дизайном сайтов, интернет-магазинов и мобильных приложений.",
    maxWidth: 521,
  },
  {
    text: "Больше 11 лет проектирую интерфейсы для\u00A0крупных продуктов. Сейчас руковожу продуктовым дизайном в\u00A0Urent, это фиолетовые самокаты.",
    maxWidth: 532,
  },
  {
    text: "Сейчас открыт к\u00A0новым проектам. Если у\u00A0вас есть интересная дизайн-задача, напишите мне.",
    maxWidth: 472,
  },
];
const topLinks = [{ href: links.telegram, label: "Написать в Telegram" }];
const bottomMessages = [
  {
    text: "Я ищу проект, где нужно глубоко продумывать логику и создавать интересные решения.",
    maxWidth: 445,
  },
  {
    text: "Изучаю рынок и конкурентов. Это помогает понять, куда всё движется, и сделать дизайн, который опережает время.",
    maxWidth: 490,
  },
  {
    text: "Мне нравится добавлять в\u00A0интерфейсы живые детали и настраивать эмоциональную связь. Это делает продукт понятным и настоящим, вызывая у\u00A0пользователя именно тот отклик, который нужен проекту.",
    maxWidth: 532,
  },
  {
    text: "Знаю, как за\u00A0счет правильной логики упростить разработку и сократить расходы, не жертвуя при этом пользовательским опытом.",
    maxWidth: 472,
  },
  {
    text: "В\u00A0общем, если у\u00A0вас есть нестандартная задача, требующая вдумчивого подхода и свежих решений — это ко\u00A0мне.",
    maxWidth: 486,
  },
];
const bottomLinks = [
  { href: links.telegram, label: "Написать в Telegram" },
  { href: links.hh, label: "Открыть резюме hh.ru" },
  { href: links.behance, label: "Открыть Behance" },
];
---

<Layout ymId="107719665">
  <Intro messages={topMessages} links={topLinks} />
  <Projects />
  <Jobs />
  <Reviews />
  <Intro messages={bottomMessages} links={bottomLinks} />
</Layout>
