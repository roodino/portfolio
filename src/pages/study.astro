---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/blocks/intro.astro";
import Projects from "../components/blocks/projects.astro";
import Jobs from "../components/blocks/jobs.astro";
import Reviews from "../components/blocks/reviews.astro";
import { links } from "../data.ts";

const topMessages = [
  "Привет, меня зовут Рустам. Более 11 лет я занимаюсь продуктовым дизайном и создаю интерфейсы для крупных цифровых продуктов.",
  "Работал с VK, Joom, FIFA и другими большими компаниями. Сейчас руковожу продуктовым дизайном в Urent — это фиолетовые самокаты.",
  "Сейчас хочу взять несколько человек на платное менторство. Помогаю с обучением, портфолио, карьерным развитием и точечными 60-минутными консультациями.",
];
const topLinks = [
  { href: links.telegram, label: "Записаться на обучение" },
  { href: links.telegram, label: "Записаться на консультацию" },
];
const bottomMessages = [
  "Я учу не просто пользоваться Figma и собирать макеты. Я помогаю понять, как мыслит дизайнер, как устроен сильный интерфейс и как решать реальные продуктовые задачи.",
  "Во многих обучениях показывают в основном инструмент, но почти не учат главному — думать, проектировать и уверенно работать с задачами из реальной практики. Поэтому после них часто есть знания программы, но нет глубины.",
  "Мне важно передавать не теорию и не красивый образ эксперта, а реальный практический опыт, который помогает быстрее расти в профессии и делать работу сильнее.",
  "И ещё дизайн — это не только про работу и деньги. Это про интерес, идеи и удовольствие от процесса. Я помогаю делать не шаблонные, а сильные и небанальные решения, которые ценятся на рынке и не дают профессии наскучить.",
  "Можно идти в полноценное обучение с уроками и сопровождением, а можно прийти точечно — на разбор портфолио, резюме, карьерной ситуации или конкретной задачи.",
];
const bottomLinks = [
  { href: telegram, label: "Записаться на обучение" },
  { href: telegram, label: "Записаться на консультацию" },
  { href: behance, label: "Открыть Behance" },
];
---

<Layout>
  <Intro messages={topMessages} links={topLinks} />
  <Projects />
  <Jobs />
  <Reviews />
  <Intro messages={bottomMessages} links={bottomLinks} />
</Layout>
