---
import Layout from "../layouts/Layout.astro";
import Intro from "../components/blocks/intro.astro";
import Projects from "../components/blocks/projects.astro";
import Jobs from "../components/blocks/jobs.astro";
import Reviews from "../components/blocks/reviews.astro";
import { links } from "../data.ts";

const topMessages = [
  {
    text: "Привет, меня зовут Рустам. Более 11 лет я занимаюсь продуктовым дизайном и создаю интерфейсы для\u00A0крупных цифровых продуктов.",
    maxWidth: 502,
  },
  {
    text: "Работал с\u00A0VK, Joom, FIFA и другими большими компаниями. Сейчас руковожу продуктовым дизайном в\u00A0Urent — это фиолетовые самокаты.",
    maxWidth: 518,
  },
  {
    text: "Сейчас хочу взять несколько человек на\u00A0платное менторство. Помогаю с\u00A0обучением, портфолио, карьерным развитием и точечными 60-минутными консультациями.",
    maxWidth: 554,
  },
];
const topLinks = [
  { href: links.telegram, label: "Записаться на обучение" },
  { href: links.telegram, label: "Записаться на консультацию" },
];
const bottomMessages = [
  {
    text: "Я учу не просто пользоваться Figma и собирать макеты. Я помогаю понять, как мыслит дизайнер, как устроен сильный интерфейс и как решать реальные продуктовые задачи.",
    maxWidth: 508,
  },
  {
    text: "Во многих обучениях показывают в\u00A0основном инструмент, но почти не учат главному — думать, проектировать и уверенно работать с\u00A0задачами из\u00A0реальной практики. Поэтому после них часто есть знания программы, но нет глубины.",
    maxWidth: 490,
  },
  {
    text: "Мне важно передавать не теорию и не красивый образ эксперта, а\u00A0реальный практический опыт, который помогает быстрее расти в\u00A0профессии и делать работу сильнее.",
    maxWidth: 532,
  },
  {
    text: "И ещё дизайн — это не только про работу и деньги. Это про интерес, идеи и удовольствие от\u00A0процесса. Я помогаю делать не шаблонные, а\u00A0сильные и небанальные решения, которые ценятся на\u00A0рынке и не дают профессии наскучить.",
    maxWidth: 472,
  },
  {
    text: "Можно идти в\u00A0полноценное обучение с\u00A0уроками и сопровождением, а можно прийти точечно — на\u00A0разбор портфолио, резюме, карьерной ситуации или конкретной задачи.",
    maxWidth: 486,
  },
];
const bottomLinks = [
  { href: links.telegram, label: "Записаться на обучение" },
  { href: links.telegram, label: "Записаться на консультацию" },
  { href: links.behance, label: "Открыть Behance" },
];
---

<Layout ymId="107719681">
  <Intro messages={topMessages} links={topLinks} />
  <Projects />
  <Jobs />
  <Reviews />
  <Intro messages={bottomMessages} links={bottomLinks} />
</Layout>
