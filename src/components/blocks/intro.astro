---
import authorPicture from "../../assets/images/author.webp";

interface Props {
  messages: { text: string; maxWidth: number }[];
  links: { href: string; label: string }[];
}

const { messages, links } = Astro.props;
---

<div class="intro">
  <div class="author">
    <div class="author__picture">
      <img
        src={authorPicture.src}
        alt="Фото Рустама"
        width="144"
        height="144"
      />
    </div>
  </div>
  <div class="feed">
    {
      messages.map(({ text, maxWidth }) => (
        <div>
          <div
            class:list={["feed__item", "p"]}
            style={`--max-width: ${maxWidth}px`}
          >
            {text}
          </div>
        </div>
      ))
    }
    {
      links.map(({ href, label }) => (
        <div>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["feed__item", "p"]}
          >
            {label}
          </a>
        </div>
      ))
    }
  </div>
</div>

<style>
  .intro {
    --avatar-size: 72px;

    /* tablet */
    @media (width >= 768px) {
      --avatar-size: 144px;
    }

    display: grid;
    grid-template-columns: var(--avatar-size) 1fr;
    gap: var(--space16);

    /* tablet */
    @media (width >= 768px) {
      gap: var(--space32);
    }

    .author {
      & .author__picture {
        position: sticky;
        top: var(--space20);
        width: var(--avatar-size);
        height: var(--avatar-size);

        &::after {
          content: "";
          position: absolute;
          bottom: 4px;
          right: 4px;
          width: 18px;
          height: 18px;
          border-radius: 50%;
          background-color: #26de20;
          border: 3px solid var(--color-bg-main);

          /* tablet */
          @media (width >= 768px) {
            bottom: 9px;
            right: 9px;
            width: 24px;
            height: 24px;
          }
        }

        img {
          border: 1px solid #0000000a;
          border-radius: 50%;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }

    .feed {
      display: grid;
      gap: var(--space12);

      & .feed__item {
        background-color: var(--color-primary-bg);
        padding: var(--space12) var(--space16);
        border-radius: var(--space16);

        /* desktop */
        @media (width >= 991px) {
          max-width: var(--max-width);
        }

        &[href] {
          display: inline-block;
          color: var(--color-primary);
          transition: color var(--transition) ease-in-out;

          &:hover {
            color: var(--color-primary-hover);
          }
        }
      }
    }
  }
</style>
