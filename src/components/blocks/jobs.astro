---
import urent from "../../assets/images/jobs/urent.svg";
import vk from "../../assets/images/jobs/vk.svg";
import joom from "../../assets/images/jobs/joom.svg";
import fifa from "../../assets/images/jobs/fifa.svg";
import evalar from "../../assets/images/jobs/evalar.svg";
import binomo from "../../assets/images/jobs/binomo.svg";
import Button from "../common/button.astro";

const initJobs = [
  {
    text: "Руковожу продуктовым дизайном в Urent. Отвечаю за мобильное приложение, сценарии аренды и общий пользовательский опыт.",
    bg: "#804AFF",
    logo: urent,
  },
  {
    text: "В команде бизнес-сообществ ВКонтакте развивал функции для бизнес-страниц и улучшал инструменты для компаний и брендов.",
    bg: "#0077FF",
    logo: vk,
  },
  {
    text: "Более четырёх лет развивал ключевые части приложения Joom: карточку товара, превью, промомеханики, поиск и каталог.",
    bg: "#3D3F56",
    logo: joom,
  },
  {
    text: "Спроектировал приложение для волонтёров Чемпионата мира 2018, которое координировало работу 20 000 человек.",
    bg: "#093697",
    logo: fifa,
  },
  {
    text: "Спроектировал международный сайт для «Эвалар» с каталогом продукции и возможностью связаться с компанией по вопросам сотрудничества.",
    bg: "#00953B",
    logo: evalar,
  },
  {
    text: "Как старший продуктовый дизайнер развивал ключевые части торговой платформы и проектировал основные пользовательские сценарии.",
    bg: "#FFDC3C",
    logo: binomo,
  },
];
---

<div class="jobs">
  <h2 class="h2">С кем работал</h2>

  <div class="grid">
    {
      initJobs.map(({ text, bg, logo }, index) => {
        const Logo = logo;
        const style =
          index > 5
            ? "display: none; height: 0; opacity: 0; margin-bottom: 0"
            : undefined;

        return (
          <div class="card" style={style}>
            <div class="card__logo" style={`background-color: ${bg}`}>
              <Logo />
            </div>
            <p class="p">{text}</p>
          </div>
        );
      })
    }
  </div>

  <div class="foot hidden">
    <div></div>
    <Button size="l" fullWidth>Показать ещё</Button>
  </div>
</div>

<style>
  .jobs {
  }

  .grid {
    margin-top: var(--space20);
    display: grid;
    gap: 0 var(--space20);

    /* desktop */
    @media (width >= 991px) {
      grid-template-columns: repeat(3, 1fr);
    }

    /* widescreen */
    @media (width >= 1200px) {
      margin-top: var(--space32);
      gap: 0 var(--space32);
    }

    .card {
      display: grid;
      gap: var(--space16);
      grid-template-rows: auto 1fr;
      overflow: hidden;
      margin-bottom: var(--space20);

      /* widescreen */
      @media (width >= 1200px) {
        margin-bottom: var(--space32);
      }

      &:nth-last-child(1) {
        margin-bottom: 0 !important;
      }

      /* desktop */
      @media (width >= 991px) {
        &:nth-last-child(1),
        &:nth-last-child(2),
        &:nth-last-child(3) {
          margin-bottom: 0 !important;
        }
      }

      & .card__logo {
        display: grid;
        place-items: center;
        aspect-ratio: 353 / 88;
        border-radius: var(--border-radius16);
      }
    }
  }

  .foot {
    overflow: hidden;
    margin-top: var(--space12);
    transition: height var(--transition);

    /* desktop */
    @media (width >= 991px) {
      display: grid;
      gap: var(--space32) var(--space20);
      grid-template-columns: repeat(3, 1fr);
    }

    /* widescreen */
    @media (width >= 1200px) {
      gap: var(--space32);
    }

    &.hidden {
      height: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";

  const jobs: NodeListOf<HTMLElement> =
    document.querySelectorAll(".jobs .card");
  const showBoreBtn: HTMLElement | null =
    document.querySelector(".jobs button");

  if (showBoreBtn) {
    let visibleCardsCount = isDesktop() ? 6 : 3;
    const desktopStep = 6;
    const mobileStep = 3;

    jobs.forEach((job, index) => {
      if (index > visibleCardsCount - 1) {
        job.style.display = "none";
        job.style.height = "0px";
        job.style.opacity = "0";
        job.style.marginBottom = "0px";
      }
    });

    if (visibleCardsCount < jobs.length) {
      const footEl: HTMLElement | null = showBoreBtn?.parentElement;
      footEl?.classList.remove("hidden");
    }

    showBoreBtn.addEventListener("click", () => {
      if (visibleCardsCount < jobs.length) {
        const step = isDesktop() ? desktopStep : mobileStep;
        const newCards = Array.from(jobs)
          .filter((job) => job.style.display === "none")
          .filter((_, index) => index < step);

        const tl = gsap.timeline();
        tl.to(newCards, { display: "grid", duration: 0 })
          .to(newCards, {
            height: "auto",
            marginBottom: isWidescreen() ? 32 : 20,
            duration: 0.25,
          })
          .to(newCards, { opacity: 1, duration: 0.35 });

        visibleCardsCount += step;

        if (visibleCardsCount >= jobs.length) {
          hideShowBtn(showBoreBtn);
        }
      }
    });
  }

  function isDesktop() {
    return window.innerWidth >= 991;
  }
  function isWidescreen() {
    return window.innerWidth >= 1200;
  }
  function hideShowBtn(btn: HTMLElement | null) {
    if (!btn) {
      return;
    }

    const footEl = btn?.parentNode;
    const tl = gsap.timeline();
    tl.to(footEl, { height: 0, duration: 0.3 }).to(footEl, {
      display: "none",
    });
  }
</script>
