---
import Button from "../common/button.astro";
import img1x1 from "../../assets/images/projects/1@1x.webp";
import img1x2 from "../../assets/images/projects/1@2x.webp";
import img2x1 from "../../assets/images/projects/2@1x.webp";
import img2x2 from "../../assets/images/projects/2@2x.webp";
import img3x1 from "../../assets/images/projects/3@1x.webp";
import img3x2 from "../../assets/images/projects/3@2x.webp";
import img4x1 from "../../assets/images/projects/4@1x.webp";
import img4x2 from "../../assets/images/projects/4@2x.webp";
import img5x1 from "../../assets/images/projects/5@1x.webp";
import img5x2 from "../../assets/images/projects/5@2x.webp";
import img6x1 from "../../assets/images/projects/6@1x.webp";
import img6x2 from "../../assets/images/projects/6@2x.webp";
import img7x1 from "../../assets/images/projects/7@1x.webp";
import img7x2 from "../../assets/images/projects/7@2x.webp";
import img8x1 from "../../assets/images/projects/8@1x.webp";
import img8x2 from "../../assets/images/projects/8@2x.webp";
import img9x1 from "../../assets/images/projects/9@1x.webp";
import img9x2 from "../../assets/images/projects/9@2x.webp";
import img10x1 from "../../assets/images/projects/10@1x.webp";
import img10x2 from "../../assets/images/projects/10@2x.webp";
import img11x1 from "../../assets/images/projects/11@1x.webp";
import img11x2 from "../../assets/images/projects/11@2x.webp";

const initCards: { link: string; label: string; images: [string, string] }[] = [
  {
    link: "https://www.behance.net/gallery/245210271/Stiki-Sticker-Shop",
    label: "Stiki — магазин стикеров",
    images: [img1x1.src, img1x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244903901/Joom-Marketplace",
    label: "Joom — международный маркетплейс",
    images: [img2x1.src, img2x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244902753/VK-Social-Network",
    label: "VK — социальная сеть",
    images: [img3x1.src, img3x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244904345/Binomo-Trading-Platform",
    label: "Binomo — трейдинговая платформа",
    images: [img4x1.src, img4x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244905711/Waliot-GPS-Tracking-Software",
    label: "Waliot — мониторинговая система",
    images: [img5x1.src, img5x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244904979/Crypterium-Crypto-Wallet",
    label: "Crypterium — криптобанк",
    images: [img6x1.src, img6x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244905487/Formula-Control-Formula-1-App",
    label: "Formula Control — новости Формулы 1",
    images: [img7x1.src, img7x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244905903/Zontik-Dating-App",
    label: "Zontik — приложение для знакомств",
    images: [img8x1.src, img8x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244906155/Cono-Calendar-New-Vision",
    label: "Cono Calendar — онлайн календарь",
    images: [img9x1.src, img9x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244905971/Cono-TV-Streaming",
    label: "Cono TV — онлайн телевизор",
    images: [img10x1.src, img10x2.src],
  },
  {
    link: "https://www.behance.net/gallery/244906441/Doggio-Pet-App",
    label: "Doggio — все для собачников",
    images: [img11x1.src, img11x2.src],
  },
];
---

<div class="projects">
  <h2 class:list={["h2", "title"]}>
    Портфолио <span>{initCards.length}</span>
  </h2>

  <div class="grid">
    {
      initCards.map(({ link, label, images }, index) => {
        const style =
          index > 5
            ? "display: none; height: 0; opacity: 0; margin-bottom: 0"
            : undefined;

        return (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="card"
            style={style}
          >
            <figure>
              <img
                src={images.at(0)}
                srcset={`${images.at(0)} 1x, ${images.at(1)} 2x`}
                alt=""
                width="360"
                height="280"
              />
              <figcaption class="p">
                <span>{label}</span>
              </figcaption>
            </figure>
          </a>
        );
      })
    }
  </div>

  <div class="foot">
    <div></div>
    <Button size="l" fullWidth>Показать ещё</Button>
  </div>
</div>

<style>
  .projects {
    --gap: var(--space20);

    /* widescreen */
    @media (width >= 1200px) {
      --gap: var(--space32);
    }

    margin-top: calc(-1 * var(--space8));

    .grid {
      margin-top: var(--gap);
      display: grid;
      gap: 0 var(--gap);

      /* desktop */
      @media (width >= 991px) {
        grid-template-columns: repeat(3, 1fr);
      }

      .card {
        overflow: hidden;
        margin-bottom: var(--gap);

        &:nth-last-child(1) {
          margin-bottom: 0 !important;
        }

        /* desktop */
        @media (width >= 991px) {
          &:nth-last-child(1),
          &:nth-last-child(2),
          &:nth-last-child(3) {
            margin-bottom: 0 !important;
          }
        }

        figure {
          margin: 0;
          display: grid;
          gap: var(--space12);

          img {
            width: 100%;
            height: auto;
            aspect-ratio: 353 / 278;
            border-radius: var(--border-radius16);

            /* tablet */
            @media (width >= 768px) {
              aspect-ratio: 360 / 280;
            }
          }

          figcaption span {
            color: var(--color-text-primary);
            text-decoration-thickness: 1.6px;
            text-underline-offset: 3.2px;
          }
        }

        &:hover figure figcaption span {
          text-decoration: underline;
        }
      }
    }

    .foot {
      overflow: hidden;

      /* desktop */
      @media (width >= 991px) {
        display: grid;
        gap: var(--gap);
        grid-template-columns: repeat(3, 1fr);
      }
    }
  }
</style>

<script>
  import gsap from "gsap";

  const projects: NodeListOf<HTMLElement> =
    document.querySelectorAll(".projects .card");
  const showMoreBtn = document.querySelector(".projects button");

  if (showMoreBtn) {
    let visibleCardsCount = isDesktop() ? 6 : 3;
    const desktopStep = 6;
    const mobileStep = 3;

    projects.forEach((project, index) => {
      if (index > visibleCardsCount - 1) {
        project.style.display = "none";
        project.style.height = "0px";
        project.style.opacity = "0";
        project.style.marginBottom = "0px";
      }
    });

    if (visibleCardsCount < projects.length) {
      const footEl: HTMLElement | null = showMoreBtn?.parentElement;
      const tl = gsap.timeline();
      tl.to(footEl, { display: "grid", duration: 0 }).to(footEl, {
        height: "auto",
        duration: 0.2,
      });
    }

    showMoreBtn.addEventListener("click", () => {
      if (visibleCardsCount < projects.length) {
        const step = isDesktop() ? desktopStep : mobileStep;
        const newCards = Array.from(projects)
          .filter((project) => project.style.display === "none")
          .filter((_, index) => index < step);

        const tl = gsap.timeline();
        tl.to(newCards, { display: "block", duration: 0 })
          .to(newCards, {
            height: "auto",
            marginBottom: "var(--gap)",
            duration: 0.15,
          })
          .to(newCards, { opacity: 1, duration: 0.35 });

        visibleCardsCount += step;

        if (visibleCardsCount >= projects.length) {
          const footEl: HTMLElement | null = showMoreBtn?.parentElement;
          const tl = gsap.timeline();
          tl.to(footEl, { height: 0, duration: 0.2 }).to(footEl, {
            display: "none",
          });
        }
      }
    });
  }

  function isDesktop() {
    return window.innerWidth >= 991;
  }
</script>
