---
import Button from "../common/button.astro";

import { initReviews } from "../../data.ts";
---

<div class="reviews">
  <h2 class:list={["h2", "title"]}>
    Отзывы обо мне <span>{initReviews.length}</span>
  </h2>

  <div class="mobile-grid"></div>

  <div class="grid">
    <div id="first"></div>
    <div id="second"></div>
    <div id="third"></div>
  </div>

  <div class="foot">
    <div></div>
    <Button size="l" fullWidth>Показать ещё</Button>
  </div>
</div>

<style is:global>
  .reviews {
    .mobile-grid {
      margin-top: var(--space20);

      /* desktop */
      @media (width >= 991px) {
        display: none;
      }
    }

    .grid {
      display: none;

      /* desktop */
      @media (width >= 991px) {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space20);
        align-items: flex-start;
        margin-top: var(--space32);
      }

      /* widescreen */
      @media (width >= 1200px) {
        gap: var(--space32);
      }
    }

    .card {
      display: grid;
      align-items: flex-start;
      grid-template-rows: min-content auto;
      gap: var(--space20);
      padding: var(--space20);
      border-radius: var(--border-radius16);

      &:not(:last-child) {
        margin-bottom: var(--space20);

        /* widescreen */
        @media (width >= 1200px) {
          margin-bottom: var(--space32);
        }
      }

      & .card__head {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 2px var(--space12);
        align-items: center;
        grid-template-areas:
          "logo company"
          "logo year";

        .logo {
          grid-area: logo;
          width: 48px;
          height: 48px;
          border-radius: 50%;
          overflow: hidden;
        }

        .company {
          grid-area: company;
        }

        .year {
          grid-area: year;
          color: var(--color-text-secondary);
        }
      }

      & .card__text {
      }
    }
  }

  .foot {
    overflow: hidden;
    transition: height var(--transition);
    margin-top: var(--space20);

    /* desktop */
    @media (width >= 991px) {
      display: grid;
      gap: var(--space20);
      grid-template-columns: repeat(3, 1fr);
      margin-top: var(--space20);
    }

    /* widescreen */
    @media (width >= 1200px) {
      gap: var(--space32);
    }

    &.hidden {
      height: 0;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { initReviews, type ICard } from "../../data.ts";

  export const reviews = shuffleReviews(initReviews);

  const initReviewCount = isDesktop() ? 6 : 3;
  const mobileStep = 3;
  const desktopStep = 6;
  let visibleClientReviews = 0;

  export const serverReviews = reviews.slice(0, initReviewCount);
  export const clientReviews = reviews.slice(initReviewCount);

  const mobileGrid: HTMLElement | null = document.querySelector(
    ".reviews .mobile-grid",
  );
  const col1: HTMLElement | null = document.querySelector(
    ".reviews .grid #first",
  );
  const col2: HTMLElement | null = document.querySelector(
    ".reviews .grid #second",
  );
  const col3: HTMLElement | null = document.querySelector(
    ".reviews .grid #third",
  );

  const showMoreBtn = document.querySelector(".reviews button");

  if (mobileGrid && col1 && col2 && col3 && showMoreBtn) {
    const cols: [HTMLElement, HTMLElement, HTMLElement] = [col1, col2, col3];
    const colsLength: [number, number, number] = [0, 0, 0];

    fillGrid(serverReviews);

    showMoreBtn.addEventListener("click", () => {
      const step = isDesktop() ? desktopStep : mobileStep;

      const reviewsChunk = clientReviews.slice(
        visibleClientReviews,
        visibleClientReviews + step,
      );
      fillGrid(reviewsChunk, true);

      visibleClientReviews += step;

      if (visibleClientReviews >= clientReviews.length) {
        const footEl: HTMLElement | null = showMoreBtn?.parentElement;
        footEl?.classList.add("hidden");
      }
    });

    function fillGrid(reviews: ICard[], withAnimation = false) {
      reviews.forEach((review) => {
        const card = document.createElement("div");
        card.classList.add("card");
        card.style.backgroundColor = `var(${review.meta.bgCard})`;
        card.innerHTML = getCardTemplate(review);

        const minLengthCol = Math.min(...colsLength);
        const minColIndex = colsLength.findIndex((col) => col === minLengthCol);

        // 100 - это магический коэффициент
        colsLength[minColIndex] += review.text.length + 100;

        const mobileCard = card.cloneNode(true) as HTMLElement;

        addToDesktop(card, minColIndex, isDesktop() && withAnimation);
        addToMobile(mobileCard, !isDesktop() && withAnimation);
      });
    }

    function addToDesktop(
      card: HTMLElement,
      index: number,
      withAnimation: boolean,
    ) {
      console.log("addToDesktop", withAnimation);

      const currentCol = cols[index];

      if (withAnimation) {
        card.style.display = "none";
        card.style.height = "0px";
        card.style.opacity = "0";
        card.style.marginBottom = "0px";
      }

      currentCol.appendChild(card);

      if (withAnimation) {
        const tl = gsap.timeline();
        tl.to(card, { display: "grid", duration: 0 })
          .to(card, {
            height: "auto",
            marginBottom: 20,
            duration: 0.15,
          })
          .to(card, { opacity: 1, duration: 0.35 });
      }
    }

    function addToMobile(card: HTMLElement, withAnimation: boolean) {
      console.log("addToMobile", withAnimation);

      if (withAnimation) {
        card.style.display = "none";
        card.style.height = "0px";
        card.style.opacity = "0";
        card.style.marginBottom = "0px";
      }

      mobileGrid?.appendChild(card);

      if (withAnimation) {
        const tl = gsap.timeline();
        tl.to(card, { display: "grid", duration: 0 })
          .to(card, {
            height: "auto",
            marginBottom: 20,
            duration: 0.15,
          })
          .to(card, { opacity: 1, duration: 0.35 });
      }
    }
  }

  function getCardTemplate(card: ICard) {
    const { text, year, meta } = card;

    return `
        <div class="card__head">
          <div class="logo">
            <img
              src=${meta.logo}
              alt={\`Логотип ${meta.label}\`}
              width="48"
              height="48"
            />
          </div>
          <p class="company p">${meta.label}</p>
          <p class="year p">${year}</p>
        </div>
        <p class="card__text p">${text}</p>
    `;
  }

  function shuffleReviews<T>(items: T[]) {
    const shuffledItems = [...items];

    for (let index = shuffledItems.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [shuffledItems[index], shuffledItems[randomIndex]] = [
        shuffledItems[randomIndex],
        shuffledItems[index],
      ];
    }

    return shuffledItems;
  }

  function isDesktop() {
    return window.innerWidth >= 991;
  }
  function isWidescreen() {
    return window.innerWidth >= 1200;
  }
</script>
